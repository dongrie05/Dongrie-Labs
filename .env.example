# URL do site em produção (sitemap, robots, meta tags)
NEXT_PUBLIC_SITE_URL=https://dongrielabs.com

# Link do Calendly para "Agendar chamada" / "Book a Call" (já configurado no código; opcional sobrescrever aqui)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/goncalo-dongrie05/30min

# Formulário de contacto. As quatro primeiras são obrigatórias.
# Se faltar alguma, POST /api/contact responde com erro e o formulário mantém o WhatsApp.
# Nunca uses NEXT_PUBLIC_ na service role key — ela só pode existir no servidor.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_resend_api_key
# Remetente que o Resend aceita. Enquanto o domínio não estiver verificado, usa
# onboarding@resend.dev (só entrega no email da conta Resend).
CONTACT_FROM_EMAIL="Dongrie Labs <onboarding@resend.dev>"
# Opcional. Se estiver vazio, o aviso vai para goncalo.dongrie05@gmail.com
CONTACT_TO_EMAIL=goncalo.dongrie05@gmail.com
